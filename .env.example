# PostgreSQL connection. Render requires SSL; the app sets rejectUnauthorized:false
# for any host that is not localhost. Do not commit real credentials.
DATABASE_URL=postgres://qiyas:qiyas@127.0.0.1:5432/qiyas

# Used only when the shop row is first created.
SHOP_NAME=Al Neel Tailoring

# Public site origin written into message links. On Netlify, URL is used if this is empty.
PUBLIC_BASE_URL=http://localhost:5173

# mock (default) | whatsapp_cloud | twilio
MESSAGE_PROVIDER=mock
# When the chosen provider fails, try Twilio SMS.
MESSAGE_FALLBACK_SMS=false

# WhatsApp Cloud API (not connected in this demo).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Twilio (not connected in this demo).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=

# Set to false to disable POST /api/seed on a public deploy.
ALLOW_SEED=true
